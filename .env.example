# Copy to .env (never commit it). Values marked REQUIRED-LIVE must be real before DRY_RUN=false.
# development | staging | production
APP_ENV=staging
PORT=8080
DATABASE_PATH=./data/marketplace.sqlite
# REQUIRED-LIVE: your HTTPS domain
PUBLIC_BASE_URL=https://tasks.example.in
# used by Caddy for automatic TLS
DOMAIN=tasks.example.in
# true = outbound WhatsApp messages are logged, not sent
DRY_RUN=true

# ---- WhatsApp Business Platform (Cloud API) — from Meta Business Manager / developers.facebook.com ----
# REQUIRED-LIVE: random string ≥24 chars you invent (openssl rand -hex 24)
WA_VERIFY_TOKEN=
# REQUIRED-LIVE: Meta App → Settings → Basic → App secret
WA_APP_SECRET=
# REQUIRED-LIVE: System User permanent token with whatsapp_business_messaging
WA_ACCESS_TOKEN=
# REQUIRED-LIVE: WhatsApp Manager → Phone numbers → Phone number ID
WA_PHONE_NUMBER_ID=
# use a currently supported Graph API version
WA_GRAPH_VERSION=v23.0
# Approved template names per message key (see docs/WHATSAPP_TEMPLATES.md). Missing keys → message waits for the user.
WA_TEMPLATES={"job_alert":"","offer_received":"","payment_request":"","booking_confirmed":"","completion_request":"","generic_update":""}
# optional: Meta WhatsApp Pay (India) payment configuration name, only once approved & Active
WA_PAYMENT_CONFIGURATION=

# ---- Razorpay (Payment Links + Route) — Dashboard → Account & Settings → API keys / Webhooks ----
# rzp_test_... in staging, rzp_live_... only with APP_ENV=production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# secret you set on the webhook pointing to /webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_LINK_TTL_MINUTES=60

# ---- Pricing (pilot assumptions — confirm with your CA) ----
FEE_RATE_HOUSEHOLD=0.18
FEE_RATE_BUSINESS=0.15
# set 0 if the business is not GST-registered (confirm with CA)
FEE_GST_RATE=0.18

# ---- Operations ----
# Operator WhatsApp numbers with roles: super | support | verifier | finance (combine with +)
# e.g. 919876543210:super,919812345678:finance+support (digits only, with 91)
ADMIN_PHONES=
# two different finance operators must approve refunds/manual payouts
FINANCE_REQUIRE_COSIGN=true
PILOT_AREAS=gachibowli,kondapur,madhapur,hitech city,kothaguda,nanakramguda,manikonda
MATCH_MAX_ALERTS=15
AUTO_CONFIRM_HOURS=48
FREE_CANCEL_HOURS=12
MAX_TASKS_PER_DAY=5
MAX_MESSAGES_PER_MINUTE=20
SUPPORT_HOURS=9 AM – 7 PM IST, Mon–Sat
# REQUIRED-LIVE: version id of lawyer-approved terms
TERMS_VERSION=draft-unapproved
# REQUIRED-LIVE: public URL of Terms of Service
TERMS_URL=
# REQUIRED-LIVE: public URL of Privacy Notice (DPDP Act 2023)
PRIVACY_URL=
